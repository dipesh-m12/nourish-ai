PORT=4000
DATABASE_URL=postgresql://user:password@host/db?sslmode=verify-full
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# AI providers (free tiers). Gemini is tried first, Groq is the fallback.
# Gemini: https://aistudio.google.com/apikey   Groq: https://console.groq.com/keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order if the main model is overloaded (same key, separate capacity)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Vision-capable Groq model, last resort for photo proof
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# S3-compatible storage (Neon). Private bucket: files are only readable via signed URLs.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=nourish-ai

# Exercise library. MuscleWiki needs a paid tier (TESTING+) for direct API use; unset = Free Exercise DB.
MUSCLEWIKI_API_KEY=

# Razorpay (test keys). Webhook: POST <public-url>/api/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Redis (checkout idempotency). EKS: REDIS_HOST=<redis service name>
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Admin routes (/api/admin/*, app version kill switch). Unset = off. openssl rand -hex 32
ADMIN_TOKEN=
