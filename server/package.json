{
  "name": "nourish-server",
  "version": "1.0.0",
  "description": "Nourish AI API — Express + Drizzle + Postgres",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^3.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
