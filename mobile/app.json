{
  "expo": {
    "name": "Nourish AI",
    "slug": "nourish-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nourishai",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.nourishai.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E1F1E6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nourishai.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E1F1E6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nourish AI uses your photos as proof for your challenges.",
          "cameraPermission": "Nourish AI uses your camera to snap proof of your challenges."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Nourish AI uses the microphone so you can say what you ate."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e26dbc54-3bc5-4ea8-8b71-d18f2a6a725d"
      }
    },
    "owner": "dipeshmishra"
  }
}
